SYMPLEONE_SECRET_KEY=change-me-in-production-use-long-random-string
SYMPLEONE_DATABASE_URL=sqlite:///./sympleone.db
SYMPLEONE_ACCESS_TOKEN_EXPIRE_MINUTES=480
SYMPLEONE_ADMIN_EMAIL=admin@sympleone.com
SYMPLEONE_ADMIN_PASSWORD=ChangeMeAdmin123!

# Amazon SP-API website authorization (POST /api/amazon/connect)
# application_id in consent URL — from Seller Central / Solution Provider Portal
AMAZON_APP_ID=amzn1.sellerapps.app.xxxxxxxx
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Optional; default https://api.amazon.com/auth/o2/token
# AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
# Must match Amazon Developer Console OAuth Redirect URI (Symple One UI route)
# On Render you can use either name:
AMAZON_REDIRECT_URI=https://your-frontend.onrender.com/amazon/callback
# AMAZON_LOGIN_URI=https://your-frontend.onrender.com/amazon/callback
# Optional override; defaults from AMAZON_OAUTH_SUCCESS_REDIRECT_URL (/connect → /callback)
# AMAZON_OAUTH_FRONTEND_CALLBACK_URL=https://your-frontend.onrender.com/amazon/callback
# Draft app testing: beta (omit this env var or leave empty for published Appstore apps)
AMAZON_AUTHORIZE_VERSION=beta
# India (A21TJRUUN4KGV) uses https://sellercentral.amazon.in — mapped in code; override for other regions:
AMAZON_DEFAULT_SELLER_CENTRAL_URL=
# OAuth state/session TTL for Amazon login and connect flows (minutes)
AMAZON_OAUTH_STATE_TTL_MINUTES=10
# Browser redirect after successful Appstore OAuth (frontend dashboard)
# After OAuth callback — seller Appstore landing page (success / error UI)
AMAZON_OAUTH_SUCCESS_REDIRECT_URL=https://your-frontend.onrender.com/amazon/connect

# Sales / orderMetrics (SP-API SigV4) — IAM user from Developer Central, not LWA app credentials:
# AMAZON_SP_API_AWS_ACCESS_KEY_ID=
# AMAZON_SP_API_AWS_SECRET_ACCESS_KEY=
# AMAZON_SP_API_AWS_REGION=eu-west-1
# Or standard AWS names: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
