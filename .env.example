SYMPLEONE_SECRET_KEY=change-me-in-production-use-long-random-string
SYMPLEONE_DATABASE_URL=sqlite:///./sympleone.db
SYMPLEONE_ACCESS_TOKEN_EXPIRE_MINUTES=480
SYMPLEONE_ADMIN_EMAIL=admin@sympleone.com
SYMPLEONE_ADMIN_PASSWORD=ChangeMeAdmin123!

# Amazon SP-API website authorization (POST /api/amazon/connect)
# application_id in consent URL — from Seller Central / Solution Provider Portal
AMAZON_APP_ID=amzn1.sellerapps.app.xxxxxxxx
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Registered OAuth redirect (used on callback; not sent in the initial consent URL)
AMAZON_REDIRECT_URI=https://your-app.example.com/api/amazon/oauth/callback
# Draft app testing: beta (omit this env var or leave empty for published Appstore apps)
AMAZON_AUTHORIZE_VERSION=beta
# India (A21TJRUUN4KGV) uses https://sellercentral.amazon.in — mapped in code; override for other regions:
AMAZON_DEFAULT_SELLER_CENTRAL_URL=
